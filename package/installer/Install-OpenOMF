        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the OpenOMF drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called OpenOMF in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": OpenOMF needs 12 MB free.")))

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "openomf.conf") (noreq))
    (set #kept (if (= #kept "") "openomf.conf" (cat #kept "|" "openomf.conf"))))
(if (exists (tackon #dest "state") (noreq))
