(if (< @installer-version 2818051)
    (abort "OpenOMF needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "OpenOMF needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "OpenOMF needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The OpenOMF drawer is not beside Install-OpenOMF. Unpack the whole archive, then run Install-OpenOMF from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The OpenOMF drawer has no openomf in it. Unpack the whole archive again."))

(welcome "This installs OpenOMF 4a94a75-amigaos3-rc2 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
